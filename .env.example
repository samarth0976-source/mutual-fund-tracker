# JWT Secret (Change this in production!)
JWT_SECRET=your-secret-key-change-this-in-production

# Cashfree Payment Gateway
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET=your_cashfree_secret

# Server Port
PORT=3000

# Frontend API URL (for CORS)
VITE_API_URL=http://localhost:3000

# ==========================================
# NEW PRODUCTION FEATURES (Add these)
# ==========================================

# MongoDB Atlas Connection String (REQUIRED for production)
# Get from: https://www.mongodb.com/cloud/atlas
# Example: mongodb+srv://fundtracker:PASSWORD@cluster0.xxxxx.mongodb.net/fundtracker
MONGODB_URI=

# Google Gemini AI API Key (OPTIONAL - for AI features)
# Get from: https://makersuite.google.com/app/apikey
# Example: AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_API_KEY=

# ==========================================
# UPSTASH REDIS (Optional - for persistent caching)
# ==========================================
# Get from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==========================================
# KOTAK NEO API (Optional - for live market data)
# ==========================================
# Get Access Token from: NEO app → Invest → TradeAPI → API Dashboard
KOTAK_ACCESS_TOKEN=
KOTAK_MOBILE=+91XXXXXXXXXX
KOTAK_UCC=XXXXX
KOTAK_MPIN=XXXXXX

